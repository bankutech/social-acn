{
  "name": "sphere",
  "version": "1.0.0",
  "description": "Sphere — Social Learning Platform",
  "main": "index.js",
  "scripts": {
    "postinstall": "cd backend && npm install",
    "start": "node backend/server.js",
    "server": "cd backend && npm start",
    "client": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm install && cd backend && npm install && cd ../frontend && npm run build",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "prepare": "husky"
  },
  "keywords": [
    "social",
    "learning",
    "sphere",
    "education"
  ],
  "author": "Sphere Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8"
  },
  "lint-staged": {
    "**/*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
